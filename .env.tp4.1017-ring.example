# DeepSeek-V4.1-Flash-1017 on a 4-node GB10 ring (2x DGX Spark + 2x Acer GN100), TP4.
# This is the environment we booted from, with addresses and paths replaced by placeholders.
# Copy to .env.tp4 and fill in the <...> values. Everything not listed here keeps the defaults of
# .env.tp4.example. Measured results for this exact line: docs/deepseek-v4.1-flash-1017.md
#
# Ring order = cable order = TP rank order:
#   rank0 node0 (head, holds the weights) - rank1 node1 - rank2 node2 - rank3 node3 - rank0
# Control/bootstrap traffic goes over the management network (a ring has no fabric path between
# opposite nodes). The data plane is the patched-NCCL ring, see docs/switchless-ring.md.

# --- v2.4 production line (README "Current results") ---
IMAGE=dsv41-4x-spark:v24-roce
BUILD_DOCKERFILE=Dockerfile.canary-roce
EP_SIZE=1
CHUNKED_PREFILL_SIZE=8192
MEM_FRACTION_STATIC=0.78
HEAD_MEM_FRACTION_STATIC=0.78
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --min-free-slots-delay 1 --enable-deepseek-v4-fp4-indexer --enable-cache-report --sleep-on-idle --swa-prefix-tails 128 --prefill-decode-interval 2 --enable-metrics"

# --- nodes (management network) ---
HEAD_IP=<node0 management IP>
WORKER_IPS="<node1 management IP> <node2 management IP> <node3 management IP>"
WORKER_HOSTS="<node1 management IP> <node2 management IP> <node3 management IP>"
WORKER_USER=<ssh user on the workers>
SSH_IDENTITY=$HOME/.ssh/id_ed25519
GLOO_SOCKET_IFNAME=<management interface>
NCCL_SOCKET_IFNAME=<management interface>
WORKER_DIR=$HOME/<checkout of this repo on the workers>

# --- ring fabric: plain switchless ring, first PCI domain only (2 HCAs) ---
IB_HCA=rocep1s0f0,rocep1s0f1
# Our mixed Spark/GN100 ring carried the IPv4 RoCE v2 GID at different indexes on different ports.
# We ran a local, un-upstreamed edit that lets files/nccl.sh, the worker settings and `doctor` accept
# NCCL_IB_GID_AUTO=1. If every fabric port has the IPv4 GID at index 3 you do not need it
# (see the GID fix in the hairpin-ring repo linked from docs/deepseek-v4.1-flash-1017.md).
NCCL_IB_GID_AUTO=1
NCCL_MAX_NCHANNELS=4
NCCL_HOST_DIR=$HOME/nccl-2.30.7-ring
NCCL_SWITCHLESS_RING_ONLY=1
NCCL_ALGO=Ring
NCCL_P2P_LEVEL=SYS
NCCL_IB_SUBNET_AWARE_ROUTING=1

# --- weights: 1017 ---
MODEL_DIR=$HOME/models/ds41-flash-1017
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash-1017
HF_REPO=deepseek-ai/DeepSeek-V4.1-Flash-1017
HF_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170
ENGRAM_DIR=$HOME/dsv41-engram-1017
WORKER_ENGRAM_DIR=$HOME/dsv41-engram-1017
# Weights live on node0 (NFS exporter) and node3 (a second exporter we started by hand, with a full
# copy, for node2, which has no direct cable to node0). Per worker in WORKER_IPS order:
#   node1 <- node0 over their direct cable, node2 <- node3 over their direct cable, node3 <- node0.
# Addresses below use placeholder subnets: one /24 per cable.
NFS_SHARE=1
NFS_VOLUME=dsv41-1017-weights
NFS_SERVER_IPS="10.50.4.2 10.50.2.1 10.50.1.1"
NFS_CLIENTS=10.50.4.1,10.50.1.2,10.50.2.2

# --- container env: v2.4 line with RoCEnante off (a plain ring has no opposite-node path) ---
EXTRA_CONTAINER_ENV="DSV41_INDEXER_CHUNKED=1 SGLANG_DSPARK_FOLDED_SAMPLING=2 SGLANG_ROCE_ALLREDUCE=0 B12X_COMPILE_CACHE_DIR=/state/b12x-compile SPARK_PREFILL_TP_SPLIT=1 SPARK_PREFILL_TP_MIN_CONTEXT=32768 SPARK_PREFILL_TP_MIN_ROWS=1024 SGLANG_RUST_BUILD_MODE=never DSV41_FAST_LOAD=1 DSV41_FAST_LOAD_EP_SIZE=1 DSV41_FAST_LOAD_TP_SLICE=auto DSV41_FAST_LOAD_N_EXPERTS=384 DSV41_FAST_LOAD_INFLIGHT_GB=6 DSV41_ENGRAM_PREFETCH=1 DSV41_SHARED_PAD_K=1 DSV41_WO_A_W8=1 DSV41_DRAFT_TAU=0.7 DSV41_DRAFT_HEAD_FP8=1 DSV41_BLOCK_VERIFY=1 DSV41_FOLDED_FENCE=1 DSV41_VERIFY_CAP=conf:0.1 DSV41_AUTOTUNE_KEEP=1 DSV41_WO_A_W8_MID=1 DSV41_WO_A_W8_DROP=1 DSV41_REPLICATED_SPLIT=wqkv_a,engram.wkv DSV41_DRAFT_MAIN_PROJ_SPLIT=1 DSV41_ROUTER_LIVE=1 DSV41_MOE_B12X_NEXT=1 DSV41_MOE_B12X_NEXT_DETERMINISTIC=1 DSV41_HC_FUSED=1 DSV41_PREFILL_SP=1 DSV41_PREFILL_SP_FP8=1 DSV41_L2_PREFETCH=1 DSV41_L2_PREFETCH_WOA=1 DSV41_SPEC_SYNC_FREE=all DSV41_EAGER_GLUE=all DSV41_CERT_HEAD=1 DSV41_CERT_HEAD_M=6,12,18,24,30,36,42,48 DSV41_PREFILL_BYPASS=256 NCCL_IB_ADDR_RANGE=10.0.0.0/8 NCCL_IB_MERGE_NICS=0 NCCL_CROSS_NIC=1"
